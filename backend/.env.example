# Copy to backend/.env for LOCAL development only. Never commit your .env.
# Actual values must be set as environment variables in the approved Render service.
# Use the Supabase project's server-side credential only in the backend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Pin staging to the project shown in the user's Supabase screenshot (public reference, not a secret).
EXPECTED_SUPABASE_PROJECT_REF=ncqpxyiuqlrnfuurvzah
SUPABASE_KEY=REPLACE_WITH_SERVER_SIDE_SECRET
# Generate with a cryptographically secure random generator: 32+ characters.
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_64_PLUS_CHAR_SECRET
# Optional comma-separated additional frontend origins; official Vercel domain is allowed by default.
# CORS_ALLOWED_ORIGINS=https://your-confirmed-custom-domain.example
